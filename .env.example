# Vector — every environment variable the server reads (validated by src/server/config/parse.ts). Copy to .env.local.
# Vector runs on PostgreSQL only. On a developer machine: `npm run db:local` creates the database, then `npm run db:migrate`.

# ── Database (required) ─────────────────────────────────────────────────────────────────────────────────────────────────
# Shared EPC2I server: postgres://vector_app:<VECTOR_APP_PASSWORD>@<host>:5432/epc2i (schema `vector`, created by Matrix).
DATABASE_URL=postgres://vector_app:vector-dev@127.0.0.1:5432/vector_dev
# Connections per process (default 10).
DATABASE_POOL_MAX=
# Seed of an EMPTY schema at `npm run db:migrate`: demo (fictional company) or production (applications and profiles only).
VECTOR_SEED=demo

# ── Sign-in (through Clavis, OpenID Connect shaped like Entra ID; Norma § 6) ──────────────────────────────────────────────
# demo (default: "View as", never exposed without HTTP authentication) | entra (sign-in through Clavis).
VECTOR_AUTH=
# ≥ 32 characters (entra): encrypts the session and sign-in cookies. `openssl rand -base64 48`.
VECTOR_SESSION_SECRET=
# Session lifetime in hours (default 12).
VECTOR_SESSION_HOURS=
# Address of Clavis (its OpenID discovery is <issuer>/.well-known/openid-configuration). ENTRA_TENANT_ID only for Entra ID itself.
ENTRA_ISSUER=
ENTRA_TENANT_ID=
# Client registered in Clavis: `npm run oidc:client -- vector https://<vector host>/api/auth/callback` (run in Clavis).
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
# Optional; default <origin of the redirect URI>/sign-in?signedOut=1.
ENTRA_POST_LOGOUT_REDIRECT_URI=
# on (required with entra): the roles Vector.* are read in clavis.pub_acces at sign-in and on every request, never in the token.
VECTOR_ACCESS_FROM_CLAVIS=

# ── E-mails (requests for quotation) ────────────────────────────────────────────────────────────────────────────────────
# none (default: nothing is sent, the message is queued and shown) | file (one .eml per message in VECTOR_MAIL_DIR — tests and
# sandbox only). Microsoft Graph Mail.Send or SMTP: to be chosen with the IT department, not built (question D-15).
VECTOR_MAIL_TRANSPORT=
VECTOR_MAIL_DIR=
# Sender (default vector@groupe.example).
VECTOR_MAIL_FROM=

# ── Sibling applications (public URLs, inlined at build time) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_KEYSTONE_URL=
NEXT_PUBLIC_CODEX_URL=
NEXT_PUBLIC_VIGIE_URL=
NEXT_PUBLIC_MATRIX_URL=

# ── Operations ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# Business clock: unset = the real date; "YYYY-MM-DD" pins it (demonstrations, tests).
VECTOR_CLOCK=
# Local files of this instance (default ./.data; /data in the image).
VECTOR_DATA_DIR=
# debug | info (default) | warn | error | silent ; json (production default) | pretty.
LOG_LEVEL=
LOG_FORMAT=

# ── Matrix (data catalogue) ─────────────────────────────────────────────────────────────────────────────────────────────
# Vector declares its tables after each migration and at start-up; unset = nothing sent.
MATRIX_URL=
MATRIX_TOKEN=
# Optional: also writes the declaration to <dir>/vector.json.
MATRIX_DECLARATIONS_DIR=

# ── Backups (npm run worker / npm run backup) ──────────────────────────────────────────────────────────────────────────
# Folder of the pg_dump backups of the schema; unset = no scheduled backup.
VECTOR_BACKUP_DIR=
# Minutes between two backups (default 1440) and days kept (default 14).
VECTOR_BACKUP_EVERY_MIN=
VECTOR_BACKUP_RETENTION_DAYS=

# ── Release and process (read by the server, not validated) ────────────────────────────────────────────────────────────
# Version declared to Matrix with the tables (optional).
APP_VERSION=
# Port of `npm run start` (default 3900, Vector's port in Norma's registry; tests 3910).
PORT=

# ── Development and tests (scripts only, never on the server) ─────────────────────────────────────────────────────────
# npm run db:local: superuser URL, database and vector_app password it creates (defaults below).
VECTOR_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
VECTOR_LOCAL_DATABASE=vector_dev
VECTOR_LOCAL_PASSWORD=vector-dev
# npm test: superuser of the server where each test file creates its own database.
VECTOR_TEST_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Build output folder (CI and verification builds: .next-ci); smoke test target (npm run test:smoke).
VECTOR_DIST_DIR=
VECTOR_SMOKE_URL=http://127.0.0.1:3910
